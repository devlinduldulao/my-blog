---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import { RECOVERY_LINKS } from "@/utils/agentContent";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center px-4">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">Page Not Found</p>
      <LinkButton
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        Go back home
      </LinkButton>
      <p class="text-sm text-muted">Looking for something else?</p>
      <ul class="mt-3 space-y-1 text-center text-sm">
        {
          RECOVERY_LINKS.map(link => (
            <li>
              <a
                href={link.href}
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Layout>
